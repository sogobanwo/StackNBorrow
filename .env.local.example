# Jupiter API key — developers.jup.ag/portal. Server-only, never expose to the client.
JUPITER_API_KEY=

# Dedicated Solana mainnet RPC (Helius, Triton, or QuickNode) — public RPC will rate-limit during a live demo.
# Wallet connection itself needs no env var — any installed Wallet Standard wallet (Phantom, Solflare, ...) is auto-discovered.
NEXT_PUBLIC_SOLANA_RPC_URL=
